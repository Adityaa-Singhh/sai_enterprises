rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ======================================================================
    // HELPER FUNCTIONS
    // ======================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    // Validate image content type and size
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024; // 5 MB limit
    }

    // Retrieve Firestore user document
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // Verify user profile exists and status is ACTIVE
    function isActive() {
      return isSignedIn() &&
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             getUserData().status == 'ACTIVE';
    }

    // Verify user is an OWNER or MANAGER
    function isManagerOrAbove() {
      return isActive() &&
             (getUserData().role == 'OWNER' || getUserData().role == 'MANAGER');
    }

    // ======================================================================
    // DEFAULT — deny everything not explicitly allowed
    // ======================================================================

    match /{allPaths=**} {
      allow read, write: if false;
    }

    // ======================================================================
    // PRODUCT IMAGES
    // Path: products/{productId}/{filename}
    // Public read | Admin write only
    // ======================================================================
    match /products/{productId}/{filename} {
      allow read: if true;
      allow write: if isManagerOrAbove() && isValidImage();
      allow delete: if isManagerOrAbove();
    }

    // ======================================================================
    // BRAND LOGOS
    // Path: brands/{brandId}/{filename}
    // Public read | Admin write only
    // ======================================================================
    match /brands/{brandId}/{filename} {
      allow read: if true;
      allow write: if isManagerOrAbove() && isValidImage();
      allow delete: if isManagerOrAbove();
    }

    // ======================================================================
    // GALLERY IMAGES
    // Path: gallery/{imageId}/{filename}
    // Public read | Admin write only
    // ======================================================================
    match /gallery/{imageId}/{filename} {
      allow read: if true;
      allow write: if isManagerOrAbove() && isValidImage();
      allow delete: if isManagerOrAbove();
    }

    // ======================================================================
    // CATEGORY IMAGES
    // Path: categories/{categoryId}/{filename}
    // Public read | Admin write only
    // ======================================================================
    match /categories/{categoryId}/{filename} {
      allow read: if true;
      allow write: if isManagerOrAbove() && isValidImage();
      allow delete: if isManagerOrAbove();
    }

    // ======================================================================
    // HOMEPAGE BANNERS
    // Path: banners/{filename}
    // Public read | Admin write only
    // ======================================================================
    match /banners/{filename} {
      allow read: if true;
      allow write: if isManagerOrAbove() && isValidImage();
      allow delete: if isManagerOrAbove();
    }

    // ======================================================================
    // AVATARS
    // Path: avatars/{userId}/{filename}
    // Public read | User write only
    // ======================================================================
    match /avatars/{userId}/{filename} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isActive() && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId && isActive();
    }

  }
}
